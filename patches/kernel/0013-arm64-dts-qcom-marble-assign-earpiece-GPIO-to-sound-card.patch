From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Halhadus <eneshakans45@proton.me>
Date: Wed, 14 Oct 2026 12:23:22 +0300
Subject: [PATCH 13/13] arm64: dts: qcom: marble: assign earpiece GPIO to sound
 card

Replace the fixed-low GPIO52 hog with the sound-card routing GPIO.
Keep loudspeaker routing as the default and let UCM select the receiver.

Signed-off-by: Halhadus <eneshakans45@proton.me>
---
 arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts | 9 +--------
 1 file changed, 1 insertion(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts
index 110c3423334c3e4a200ac1bd8e5eb5adeb078c19..1b391d31ee41d2c3fc4d4fedcb2cef16dfaa8227 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts
@@ -1153,14 +1153,6 @@ speaker-bottom-reset-hog {
 		line-name = "speaker-bottom-reset-n";
 	};
 
-	/* Routes the top amp to the top speaker (high: earpiece) */
-	speaker-earpiece-switch-hog {
-		gpio-hog;
-		gpios = <52 GPIO_ACTIVE_HIGH>;
-		output-low;
-		line-name = "speaker-earpiece-switch";
-	};
-
 	tert_mi2s_active: tert-mi2s-active-state {
 		sck-pins {
 			pins = "gpio121";
@@ -1195,6 +1187,7 @@ data1-pins {
 &sound {
 	compatible = "qcom,sm8450-sndcard";
 	model = "SM8475-Xiaomi-Marble";
+	speaker-earpiece-gpios = <&tlmm 52 GPIO_ACTIVE_HIGH>;
 
 	pinctrl-0 = <&tert_mi2s_active>;
 	pinctrl-names = "default";
