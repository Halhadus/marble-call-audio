+				if (!info)
+					apm->result.status = EINVAL;
+			}
 			wake_up(&apm->wait);
 			break;
 		default:
@@ -970,6 +1050,8 @@ static int apm_callback(const struct gpr_resp_pkt *data, void *priv, int op)
 		}
 		break;
 	case APM_CMD_RSP_SHARED_MEM_MAP_REGIONS:
+		if (!data->payload || data->payload_size < (int)sizeof(*rsp))
