 	struct idr sub_graphs_idr;
 	struct idr containers_idr;
 	struct idr modules_idr;
+	const void *hostless_owner; /* Protected by graph_lock. */
+	bool topology_uncertain; /* Sticky until APM reinitialization after a DSP failure. */
 };
 
 struct audio_buffer {
