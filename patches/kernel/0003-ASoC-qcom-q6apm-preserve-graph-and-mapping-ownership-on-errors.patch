@@ -44,14 +45,22 @@ static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, ui
 	struct audioreach_graph *graph;
 	int id;
 
+	guard(mutex)(&apm->graph_lock);
