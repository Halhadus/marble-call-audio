From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Halhadus <eneshakans45@proton.me>
Date: Wed, 14 Oct 2026 12:23:22 +0300
Subject: [PATCH 10/13] dt-bindings: sound: qcom: describe speaker-earpiece
 routing

Describe the optional GPIO selecting loudspeaker or earpiece routing on
boards sharing an amplifier between those outputs.

Signed-off-by: Halhadus <eneshakans45@proton.me>
---
 Documentation/devicetree/bindings/sound/qcom,sm8250.yaml | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml b/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml
index dae440ecab5903e972887229372ec7335e801944..42c953a7f9ca6faabbf8f2d7b97d0277d5c95eb8 100644
--- a/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml
+++ b/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml
@@ -68,6 +68,12 @@ properties:
     $ref: /schemas/types.yaml#/definitions/string
     description: User visible long sound card name
 
+  speaker-earpiece-gpios:
+    maxItems: 1
+    description:
+      GPIO controlling an amplifier output switch. The active state routes
+      the amplifier to the earpiece, and the inactive state to the speaker.
+
 patternProperties:
   ".*-dai-link$":
     description:
